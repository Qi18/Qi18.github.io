---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面没有找到">
  <section class="not-found shell">
    <p class="eyebrow"><span></span> ERROR 404</p>
    <h1>这一页还没有被写下。</h1>
    <p>它可能被移动了，也可能从来没有存在过。</p>
    <a class="button primary" href="/">回到首页</a>
  </section>
</BaseLayout>
