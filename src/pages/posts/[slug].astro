---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReadingMinutes, sortPostsByDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = sortPostsByDate(await getCollection('posts', ({ data }) => !data.draft));
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      olderPost: posts[index + 1],
      newerPost: posts[index - 1],
    },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  olderPost?: CollectionEntry<'posts'>;
  newerPost?: CollectionEntry<'posts'>;
}

const { post, olderPost, newerPost } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
const readingMinutes = getReadingMinutes(post.body ?? '');
const formatDate = (value: Date) => value.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const date = formatDate(post.data.publishedAt);
const updatedDate = post.data.updatedAt ? formatDate(post.data.updatedAt) : undefined;
---

<BaseLayout title={post.data.title} description={post.data.description} article>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <article class="post shell">
    <header class="post-header">
      <a class="back-link" href="/series">← 返回系列</a>
      {post.data.series && (
        <p class="post-series">
          <a href={`/series/${encodeURIComponent(post.data.series)}/`}>
            {post.data.series}{post.data.seriesOrder ? ` · ${String(post.data.seriesOrder).padStart(2, '0')}` : ''}
          </a>
        </p>
      )}
      <h1>{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>
      <div class="post-meta">
        <time datetime={post.data.publishedAt.toISOString()}>{date}</time>
        <span>·</span>
        <span>{readingMinutes} 分钟阅读</span>
        {updatedDate && <><span>·</span><span>更新于 {updatedDate}</span></>}
        <span>·</span>
        <div class="tag-list">
          {post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
        </div>
      </div>
    </header>

    {tocHeadings.length > 0 && (
      <details class="mobile-toc">
        <summary>本页目录 <span>{tocHeadings.length} 节</span></summary>
        <nav aria-label="移动端本页目录">
          {tocHeadings.map((heading) => (
            <a class:list={[`toc-depth-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a>
          ))}
        </nav>
      </details>
    )}

    <div class="post-layout">
      <div class="prose"><Content /></div>
      {tocHeadings.length > 0 && (
        <aside class="toc">
          <p>本页目录</p>
          <nav aria-label="本页目录">
            {tocHeadings.map((heading) => (
              <a class:list={[`toc-depth-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        </aside>
      )}
    </div>

    <div class="article-actions" aria-label="文章操作">
      <div>
        <p>SHARE / 收藏这篇文章</p>
        <span>把链接留给以后，或分享给也在研究这个问题的人。</span>
      </div>
      <div class="article-action-buttons">
        <button class="article-action share-article" type="button">分享文章</button>
        <button class="article-action copy-article-link" type="button">复制链接</button>
      </div>
    </div>

    {(olderPost || newerPost) && (
      <nav class="post-navigation" aria-label="文章翻页">
        {olderPost ? (
          <a class="post-navigation-item" href={`/posts/${olderPost.id}/`}>
            <span>← 上一篇</span>
            <strong>{olderPost.data.title}</strong>
          </a>
        ) : <span></span>}
        {newerPost && (
          <a class="post-navigation-item next" href={`/posts/${newerPost.id}/`}>
            <span>下一篇 →</span>
            <strong>{newerPost.data.title}</strong>
          </a>
        )}
      </nav>
    )}
  </article>

  <button class="back-to-top" type="button" aria-label="返回顶部" title="返回顶部">↑</button>
  <div class="copy-fallback" hidden role="dialog" aria-modal="true" aria-labelledby="copy-fallback-title">
    <div class="copy-fallback-card">
      <div>
        <p id="copy-fallback-title">浏览器未允许自动复制</p>
        <span>内容已选中，请按 ⌘C 或 Ctrl+C。</span>
      </div>
      <textarea readonly aria-label="待复制内容"></textarea>
      <button type="button">关闭</button>
    </div>
  </div>

  <script>
    const progressBar = document.querySelector<HTMLElement>('.reading-progress span');
    const article = document.querySelector<HTMLElement>('.post');

    const updateReadingProgress = () => {
      if (!progressBar || !article) return;
      const start = article.offsetTop;
      const distance = article.offsetHeight - window.innerHeight;
      const progress = distance > 0 ? Math.min(1, Math.max(0, (window.scrollY - start) / distance)) : 1;
      progressBar.style.transform = `scaleX(${progress})`;
    };

    updateReadingProgress();
    window.addEventListener('scroll', updateReadingProgress, { passive: true });
    window.addEventListener('resize', updateReadingProgress);

    const copyText = async (value: string) => {
      try {
        await navigator.clipboard.writeText(value);
        return true;
      } catch {
        const fallback = document.querySelector<HTMLElement>('.copy-fallback');
        const textarea = fallback?.querySelector<HTMLTextAreaElement>('textarea');
        if (fallback && textarea) {
          textarea.value = value;
          fallback.hidden = false;
          textarea.focus();
          textarea.select();
        }
        return false;
      }
    };

    document.querySelectorAll<HTMLElement>('.prose pre').forEach((block) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy';
      button.textContent = '复制';
      button.setAttribute('aria-label', '复制代码');
      button.addEventListener('click', async () => {
        const code = block.querySelector('code')?.textContent ?? block.textContent ?? '';
        button.textContent = await copyText(code) ? '已复制' : '请手动复制';
        window.setTimeout(() => { button.textContent = '复制'; }, 4000);
      });
      block.append(button);
    });

    const setTemporaryLabel = (button: HTMLButtonElement | null, label: string) => {
      if (!button) return;
      const original = button.textContent ?? '';
      button.textContent = label;
      window.setTimeout(() => { button.textContent = original; }, 4000);
    };

    const copyArticleUrl = async (button: HTMLButtonElement | null) => {
      setTemporaryLabel(button, await copyText(window.location.href) ? '链接已复制' : '请手动复制');
    };

    const shareButton = document.querySelector<HTMLButtonElement>('.share-article');
    const copyLinkButton = document.querySelector<HTMLButtonElement>('.copy-article-link');
    shareButton?.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({ title: document.title, text: document.querySelector<HTMLMetaElement>('meta[name="description"]')?.content, url: window.location.href });
          return;
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
        }
      }
      await copyArticleUrl(shareButton);
    });
    copyLinkButton?.addEventListener('click', () => copyArticleUrl(copyLinkButton));

    const backToTop = document.querySelector<HTMLButtonElement>('.back-to-top');
    const updateBackToTop = () => backToTop?.classList.toggle('visible', window.scrollY > 560);
    updateBackToTop();
    window.addEventListener('scroll', updateBackToTop, { passive: true });
    backToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

    const copyFallback = document.querySelector<HTMLElement>('.copy-fallback');
    const closeCopyFallback = copyFallback?.querySelector<HTMLButtonElement>('button');
    closeCopyFallback?.addEventListener('click', () => {
      if (copyFallback) copyFallback.hidden = true;
    });
    copyFallback?.addEventListener('click', (event) => {
      if (event.target === copyFallback) copyFallback.hidden = true;
    });
  </script>
</BaseLayout>
