---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import KnowledgeTree from '../../components/KnowledgeTree.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildKnowledgeTree } from '../../lib/knowledge';
import { sortPostsByDate } from '../../lib/posts';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const knowledgePosts = posts.filter((post) => post.data.knowledgePath?.length);
const independentPosts = sortPostsByDate(posts.filter((post) => !post.data.knowledgePath?.length));
const tree = buildKnowledgeTree(knowledgePosts);
---

<BaseLayout title="知识库" description="按照 Obsidian 的目录和编号，浏览已经公开的知识笔记。">
  <header class="page-header shell knowledge-header">
    <p class="eyebrow"><span></span> KNOWLEDGE VAULT</p>
    <h1>知识库</h1>
    <p>沿用本地 Obsidian 的目录与编号。这里只呈现明确公开的分支，未公开目录不会出现在博客中。</p>
  </header>

  <section class="shell knowledge-page">
    <div class="knowledge-summary">
      <span>{String(tree.length).padStart(2, '0')} 个公开根目录</span>
      <span>{String(knowledgePosts.length).padStart(2, '0')} 篇知识笔记</span>
    </div>
    {tree.length > 0
      ? <KnowledgeTree nodes={tree} />
      : <p class="knowledge-empty">还没有标记为公开的知识笔记。</p>}
  </section>

  {independentPosts.length > 0 && (
    <section class="shell independent-writing">
      <div class="section-heading">
        <div>
          <p class="section-kicker">INDEPENDENT WRITING</p>
          <h2>独立文章</h2>
        </div>
        <a class="text-link" href="/posts">按时间查看 <span>→</span></a>
      </div>
      <div class="article-list">
        {independentPosts.map((post) => <ArticleCard post={post} />)}
      </div>
    </section>
  )}
</BaseLayout>
