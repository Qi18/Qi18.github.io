---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesTree from '../../components/SeriesTree.astro';
import { buildSeriesTree, sortPostsByDate } from '../../lib/posts';

const posts = sortPostsByDate(await getCollection('posts', ({ data }) => !data.draft && Boolean(data.series)));
const seriesTree = buildSeriesTree(posts);
---

<BaseLayout title="系列" description="沿着系列阅读，把零散知识连接成完整路线。">
  <header class="page-header shell">
    <p class="eyebrow"><span></span> LEARNING PATHS</p>
    <h1>系列</h1>
    <p>从一篇文章进入，再沿着上下文把问题看完整。</p>
  </header>

  <section class="shell page-content">
    <div class="series-tree-panel">
      <div class="series-tree-heading">
        <span>系列目录</span>
        <span>{seriesTree.length} 个根目录 · {posts.length} 篇文章</span>
      </div>
      <SeriesTree nodes={seriesTree} />
    </div>
  </section>
</BaseLayout>
