---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortPostsBySeries } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft && Boolean(data.series));
  const seriesNames = [...new Set(posts.map((post) => post.data.series!))];

  return seriesNames.map((series) => ({
    params: { series },
    props: {
      series,
      posts: sortPostsBySeries(posts.filter((post) => post.data.series === series)),
    },
  }));
}

interface Props {
  series: string;
  posts: CollectionEntry<'posts'>[];
}

const { series, posts } = Astro.props;
---

<BaseLayout title={series} description={`“${series}”系列的全部文章。`}>
  <header class="page-header shell compact">
    <a class="back-link" href="/series">← 全部系列</a>
    <p class="section-kicker">SERIES / {String(posts.length).padStart(2, '0')} POSTS</p>
    <h1>{series}</h1>
    <p>按阅读顺序整理，共 {posts.length} 篇文章。</p>
  </header>

  <section class="shell page-content">
    <div class="article-list series-article-list">
      {posts.map((post) => <ArticleCard post={post} />)}
    </div>
  </section>
</BaseLayout>
