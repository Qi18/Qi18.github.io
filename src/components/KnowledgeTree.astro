---
import type { KnowledgeNode } from '../lib/knowledge';
import { getKnowledgeAnchor, getKnowledgeNumber } from '../lib/knowledge';

interface Props {
  nodes: KnowledgeNode[];
  depth?: number;
}

const { nodes, depth = 0 } = Astro.props;
---

<ol class:list={['knowledge-tree-level', `knowledge-depth-${depth}`]}>
  {nodes.map((node) => (
    <li class="knowledge-branch" id={getKnowledgeAnchor(node.path)}>
      <div class="knowledge-folder">
        <span class="knowledge-folder-index">{String(node.name.match(/^\d+/)?.[0] ?? depth + 1).padStart(2, '0')}</span>
        <div>
          <p>{depth === 0 ? 'ROOT' : `LEVEL ${depth + 1}`}</p>
          <h2>{node.name}</h2>
        </div>
        <span class="knowledge-folder-count">{node.totalPosts} 篇</span>
      </div>

      {node.children.length > 0 && <Astro.self nodes={node.children} depth={depth + 1} />}

      {node.posts.length > 0 && (
        <ol class="knowledge-leaves">
          {node.posts.map((post) => (
            <li>
              <a href={`/posts/${post.id}/`}>
                <span class="knowledge-leaf-index">{getKnowledgeNumber(post) || '·'}</span>
                <span>
                  <strong>{post.data.title}</strong>
                  <small>{post.data.description}</small>
                </span>
                <i>→</i>
              </a>
            </li>
          ))}
        </ol>
      )}
    </li>
  ))}
</ol>
